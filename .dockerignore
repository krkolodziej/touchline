# Anything the build makes for itself, and anything that must never be baked in.
#
# Note the patterns under storage/: they exclude the *contents* and keep the `.gitignore`
# placeholders, because those placeholders are the only thing that puts the directories in
# the image at all. Excluding them leaves Laravel with nowhere to write its log, and the
# first thing that tries to log then turns every request into a 500.
.git
.github
.env
.env.*
!.env.example
node_modules
vendor
public/build
public/hot
public/storage
# Never ship a cache built on somebody's laptop. The route cache in particular is full of
# absolute paths from the machine that made it, and the package manifest lists the dev
# dependencies that machine had — neither of which exists in the image. The build makes
# its own.
bootstrap/cache/*.php

storage/logs/*.log
storage/framework/cache/data/**/*
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*.php
tests
phpunit.xml
phpstan.neon
pint.json
.prettierrc
.editorconfig
README.md
